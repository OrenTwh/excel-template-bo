{
  "info": {
    "name": "Court Bookings API",
    "_postman_id": "court-bookings-collection",
    "description": "Court Booking endpoints — single & multiple court creation, listing, details, cancel, receipt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/xparkbo",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_BEARER_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "booking_id",
      "value": "",
      "type": "string",
      "description": "Encrypted booking ID returned from Create Booking — auto-set by the test script"
    }
  ],
  "item": [
    {
      "name": "Create Booking — Single Court",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var json = pm.response.json();",
              "    if (json.data && json.data.id) {",
              "        pm.collectionVariables.set('booking_id', json.data.id);",
              "        console.log('booking_id set to:', json.data.id);",
              "    }",
              "}",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Has booking_no', () => pm.expect(pm.response.json().data).to.have.property('booking_no'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "court_id",
              "value": "E2",
              "description": "Encrypted court ID"
            },
            {
              "key": "booking_date",
              "value": "2026-04-15",
              "description": "Y-m-d, today or future"
            },
            {
              "key": "start_time",
              "value": "10:00"
            },
            {
              "key": "end_time",
              "value": "11:00"
            },
            {
              "key": "participants",
              "value": "1"
            },
            {
              "key": "notes",
              "value": "Extra shuttlecocks please",
              "disabled": true
            },
            {
              "key": "voucher_code",
              "value": "SAVE20",
              "disabled": true
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/create",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "create"]
        },
        "description": "Creates a single court booking. Uses flat (non-array) field names — same format as the original API."
      }
    },
    {
      "name": "Create Booking — Multiple Courts (2 courts)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var json = pm.response.json();",
              "    if (json.data && json.data.bookings && json.data.bookings[0]) {",
              "        pm.collectionVariables.set('booking_id', json.data.bookings[0].id);",
              "        console.log('booking_id set to first booking:', json.data.bookings[0].id);",
              "    }",
              "}",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns bookings array', () => {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.bookings).to.be.an('array').with.lengthOf(2);",
              "});",
              "pm.test('Has grand_total', () => pm.expect(pm.response.json().data).to.have.property('grand_total'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "court_id[0]",
              "value": "E2",
              "description": "Encrypted court ID — first court"
            },
            {
              "key": "booking_date[0]",
              "value": "2026-04-15"
            },
            {
              "key": "start_time[0]",
              "value": "10:00"
            },
            {
              "key": "end_time[0]",
              "value": "11:00"
            },
            {
              "key": "participants[0]",
              "value": "2"
            },
            {
              "key": "notes[0]",
              "value": "Court 1 notes",
              "disabled": true
            },
            {
              "key": "court_id[1]",
              "value": "E3",
              "description": "Encrypted court ID — second court"
            },
            {
              "key": "booking_date[1]",
              "value": "2026-04-15"
            },
            {
              "key": "start_time[1]",
              "value": "14:00"
            },
            {
              "key": "end_time[1]",
              "value": "15:30"
            },
            {
              "key": "participants[1]",
              "value": "3"
            },
            {
              "key": "notes[1]",
              "value": "Court 2 notes",
              "disabled": true
            },
            {
              "key": "voucher_code",
              "value": "SAVE20",
              "description": "Applied to combined grand total",
              "disabled": true
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/create",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "create"]
        },
        "description": "Creates two court bookings in one request using indexed array fields (court_id[0], court_id[1], …). Response includes `bookings` array, `grand_total`, and `total_discount`."
      }
    },
    {
      "name": "Create Booking — Multiple Courts (3 courts + voucher)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Returns 3 bookings', () => {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.bookings).to.be.an('array').with.lengthOf(3);",
              "});",
              "pm.test('Discount distributed', () => {",
              "    var json = pm.response.json();",
              "    var sumDiscount = json.data.bookings.reduce((s, b) => s + b.discount_amount, 0);",
              "    pm.expect(Math.abs(sumDiscount - json.data.total_discount)).to.be.below(0.05);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "court_id[0]",     "value": "E2" },
            { "key": "booking_date[0]", "value": "2026-04-16" },
            { "key": "start_time[0]",   "value": "09:00" },
            { "key": "end_time[0]",     "value": "10:00" },
            { "key": "participants[0]", "value": "1" },
            { "key": "court_id[1]",     "value": "E3" },
            { "key": "booking_date[1]", "value": "2026-04-16" },
            { "key": "start_time[1]",   "value": "11:00" },
            { "key": "end_time[1]",     "value": "12:00" },
            { "key": "participants[1]", "value": "2" },
            { "key": "court_id[2]",     "value": "E4" },
            { "key": "booking_date[2]", "value": "2026-04-16" },
            { "key": "start_time[2]",   "value": "14:00" },
            { "key": "end_time[2]",     "value": "15:00" },
            { "key": "participants[2]", "value": "4" },
            { "key": "voucher_code",    "value": "SAVE20" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/create",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "create"]
        },
        "description": "3 courts + a voucher. The test script verifies that the sum of per-booking discounts equals the total_discount (within rounding tolerance)."
      }
    },
    {
      "name": "Create Booking — Validation Error (end_time before start_time)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('Has error message', () => pm.expect(pm.response.json().status).to.eql('error'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept",        "value": "application/json" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "court_id[0]",     "value": "E2" },
            { "key": "booking_date[0]", "value": "2026-04-15" },
            { "key": "start_time[0]",   "value": "11:00" },
            { "key": "end_time[0]",     "value": "10:00",  "description": "Intentionally before start_time" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/create",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "create"]
        },
        "description": "Expects a 422 because end_time[0] is before start_time[0]."
      }
    },
    {
      "name": "Create Booking — Validation Error (missing required fields)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('Has errors object', () => pm.expect(pm.response.json()).to.have.property('errors'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept",        "value": "application/json" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "court_id", "value": "E2" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/create",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "create"]
        },
        "description": "Sends only court_id — expects 422 with validation errors for missing date/time fields."
      }
    },
    {
      "name": "Get My Bookings",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has data', () => pm.expect(pm.response.json()).to.have.property('data'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept",        "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings?per_page=15",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings"],
          "query": [
            { "key": "status",    "value": "1",          "disabled": true, "description": "1=Pending, 10=Upcoming, 11=Complete, 20=Suspended, 21=Canceled" },
            { "key": "date_from", "value": "2026-04-01", "disabled": true },
            { "key": "date_to",   "value": "2026-04-30", "disabled": true },
            { "key": "per_page",  "value": "15" }
          ]
        }
      }
    },
    {
      "name": "Get One Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 404', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept",        "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/details?id={{booking_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "details"],
          "query": [
            { "key": "id", "value": "{{booking_id}}", "description": "Encrypted booking ID" }
          ]
        }
      }
    },
    {
      "name": "Cancel Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 422', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 422]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Accept",        "value": "application/json" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "id",                  "value": "{{booking_id}}" },
            { "key": "cancellation_reason", "value": "Change of plans" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/cancel",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "cancel"]
        }
      }
    },
    {
      "name": "Download Receipt (PDF)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/court-bookings/receipt?id={{booking_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "court-bookings", "receipt"],
          "query": [
            { "key": "id", "value": "{{booking_id}}" }
          ]
        },
        "description": "Streams the PDF receipt. In Postman, click 'Send and Download' to save the file."
      }
    }
  ]
}
